//This is the safe template you can commit to GitHub.
//Others know which keys are needed, but not your real secrets.
BASE_URL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
DASHBOARD_URL=https://opensource-demo.orangehrmlive.com/web/index.php/dashboard/index


# Optional — enables live AI failure diagnosis in reports/ai-failures/
OPENAI_API_KEY=

# Optional — email failure report (Gmail example below)
# Local runs never email. CI emails only when smoke workflow sets SEND_FAILURE_EMAIL=true.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=